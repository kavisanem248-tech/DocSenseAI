# ===============================================
# AI REPORT ANALYZER - ENVIRONMENT CONFIGURATION
# ===============================================

# Server Port
PORT=5000

# Active AI Provider: 'gemini' | 'openai' | 'builtin'
# Note: If no API key is provided, the system seamlessly uses the built-in high-precision engine!
AI_PROVIDER=gemini

# Google Gemini API Key
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI / Compatible API Key (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Preferred Model Name (e.g. gemini-1.5-flash, gemini-1.5-pro, gpt-4o-mini)
AI_MODEL=gemini-1.5-flash

# Storage & Database (Optional Supabase / PostgreSQL configuration)
# By default, local high-speed persistent storage is automatically enabled.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
